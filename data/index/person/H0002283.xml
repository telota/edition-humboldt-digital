                    <persName type="reg">
                        <surname>Ustáriz</surname>
                        <forename>Francisco Javier</forename>
                    </persName>
                    <birth>1772</birth>
                    <death>1814</death>
                    <note resp="Humboldt_2000">Neffe des Marquez de Ustáriz; dritter Sohn des José Ignacio Ustáriz y
                        Tovar (1738-1789) (des Bruders von Jerónimo Ustáriz y Tovar) und der Josefa
                        Mijares y Solórzano; Jurist und Politiker; führendes Mitglied der
                        venezolanischen Unabhängigkeitsberwegung, Mitunterzeichner der
                        Unabhängigkeitserklärung von 1811 in Caracas und Autor der ersten Verfassung
                        Venezuelas, 1814 gefallen in der
                        Schlacht
                        von Urica </note>
                    <linkGrp>
                        <ptr target="16#80" type="letter"/>
                    </linkGrp>
                </person></listPerson></body></text></TEI>