    <text><body>
            <div type="writingSession">
                <pb n="1r"/>
                <opener>
                    <salute><del rendition="#s">Mein <unclear reason="covered" cert="high">Herr</unclear>,</del> Mein Wohltäter <choice>
                            <abbr>u</abbr>
                            <expan>und</expan>
                        </choice> Freund,</salute>
                </opener>
                <p><gap quantity="3" unit="chars" reason="insignificant"/><subst>
                        <del rendition="#ow">D</del>
                        <add place="across">Es</add>
                    </subst> ist zu viel auf einmahl, als daß ich aussprechen <lb/>kö<choice>
                        <orig>n̅</orig>
                        <reg>nn</reg>
                    </choice>te, wie sehr Ihr heutig<supplied cert="high">es</supplied> Schreiben
                    mich gerührt; ich war
                    <lb/>eben
                    beÿ Ihnen <choice>
                        <abbr>u</abbr>
                        <expan>und</expan>
                    </choice> wollte es versuchen Ihnen zu danken; <add place="intralinear"><subst>
                            <del rendition="#ow"><gap reason="illegible" quantity="3" unit="chars"/></del>
                            <add place="across">ich k</add>
                        </subst>a<choice>
                            <orig>n̅</orig>
                            <reg>nn</reg>
                        </choice> nicht <lb/></add><hi rendition="#mMM"><add place="superlinear">warten es zu thun, bis ich<del rendition="#s">,
                                hoffentlich morgen,</del> glücklicher bin, Sie zu
                        treffen.</add></hi>
                    <lb/><add place="intralinear"><del rendition="#s"><unclear reason="covered" cert="low">Leben</unclear></del></add>Und in welchem Augenblick ist
                    mir Ihre Hülfe zu Th<supplied cert="high">ei</supplied>l <lb/>geworden! Ich lege
                    Ihnen einen Brief meiner lieben <persName ref="https://edition-humboldt.de/H0012521">Mutter</persName> bey,
                    aus dem <lb/>Sie meine <subst>
                        <del rendition="#ow"><gap reason="covered" unit="words" quantity="1"/></del>
                        <add place="across">ganze</add>
                    </subst> Lage ersehen kö<choice>
                        <orig>n̅</orig>
                        <reg>nn</reg>
                    </choice>en. Zwar willigen <lb/><subst>
                        <del rendition="#ow">die</del>
                        <add place="across">meine</add>
                    </subst>
                    <subst>
                        <del rendition="#ow"><gap reason="covered" unit="words" quantity="1"/></del>
                        <add place="across"><ref xml:id="a0f4fef6-871c-4d26-b4fe-f6871ccd260e" corresp="#d8019f24-9a65-4e3d-819f-249a655e3d03" type="editorialNote">Eltern</ref><note xml:id="d8019f24-9a65-4e3d-819f-249a655e3d03" corresp="#a0f4fef6-871c-4d26-b4fe-f6871ccd260e" type="editorial"><persName ref="https://edition-humboldt.de/H0012521">Rose</persName>
                                    und <persName ref="https://edition-humboldt.de/H4729051">Louis Benjamin Rodolphe
                                        Agassiz</persName>,</note></add>
                    </subst> jetzt darin ein, daß ich <subst>
                        <del rendition="#ow"><del rendition="#s"><gap reason="illegible" quantity="1" unit="chars"/></del></del>
                        <add place="across">m</add>
                    </subst>ich <del rendition="#s">ganz</del> der <choice>
                        <abbr>Naturwissensch</abbr>
                        <expan>Naturwissenschaft</expan>
                    </choice>
                    <lb/>hingebe <choice>
                        <abbr>u</abbr>
                        <expan>und</expan>
                    </choice> ich bin <choice>
                        <abbr>vd</abbr>
                        <expan>von dem</expan>
                    </choice> lästigen Gedanken befreit, dad<supplied cert="high">urc</supplied>h
                        <lb/><hi rendition="#mMM">gegen <subst>
                            <del rendition="#ow">Ihre<subst>
                                    <del rendition="#ow">n</del>
                                    <add place="across">m</add>
                                </subst></del>
                            <add place="across">die</add>
                        </subst> Wünsche <choice>
                            <abbr>u</abbr>
                            <expan>und</expan>
                        </choice>
                        <subst>
                            <del rendition="#ow">Ihre<subst>
                                    <del rendition="#ow">n</del>
                                    <add place="across">m</add>
                                </subst></del>
                            <add place="across">den</add>
                        </subst> Willen <add place="superlinear"><del rendition="#s"><del rendition="#s"><gap reason="illegible" quantity="1" unit="words"/></del></del></add> zu handeln<supplied cert="high">,</supplied>
                        <add place=" across">der <unclear reason="illegible" cert="high">mir</unclear>
                            <gap reason="covered" unit="chars" quantity="1"/><unclear reason="illegible" cert="low">ernstliche</unclear>
                            <unclear reason="illegible" cert="low">Kindes</unclear></add><gap reason="illegible" unit="chars" quantity="5"/>; aber die Mittel mir</hi>
                    <lb/>weiter zu helfen<supplied cert="high">,</supplied> fehlen <subst>
                        <del rendition="#ow">I</del>
                        <add place="across">i</add>
                    </subst>hnen <choice>
                        <abbr>u</abbr>
                        <expan>und</expan>
                    </choice> dieselben zu erhalten<supplied cert="high">,</supplied> wird mir
                        vorgeschlagen<supplied cert="high">,</supplied>
                    <lb/><add place="left">in </add>die Heÿmath zurückzukehren <choice>
                        <abbr>u</abbr>
                        <expan>und</expan>
                    </choice> entweder in <placeName ref="https://edition-humboldt.de/H0010833 https://www.geonames.org/2660646">Genf</placeName>
                    <choice>
                        <abbr>od</abbr>
                        <expan>oder</expan>
                    </choice>
                    <placeName ref="https://edition-humboldt.de/H0011394">Lausa<choice>
                            <orig>n̅</orig>
                            <reg>nn</reg>
                        </choice>e</placeName> Vorträge <lb/><hi rendition="#mMM">zu halten. Bereits
                        habe ich vorig<subst>
                            <del rendition="#ow">e</del>
                            <add place="across">en</add>
                        </subst>
                        <subst>
                            <del rendition="#ow">Woche</del>
                            <add place="across">So<choice>
                                    <orig>n̅</orig>
                                    <reg>nn</reg>
                                </choice>abend</add>
                        </subst> meine<supplied cert="high">n</supplied>
                        <subst>
                            
                            <del rendition="#ow"> Zusti<choice>
                                    <orig>m̅</orig>
                                    <reg>mm</reg>
                                </choice><supplied cert="high">un</supplied>g </del>
                            <add place="across">Entschluß</add>
                        </subst> hingeschrieben,</hi>
                    <lb/>diese<subst>
                        <del rendition="#ow">n</del>
                        <add place="across">m</add>
                    </subst> Vorschlag <add place="superlinear">mit dem nächsten So<choice>
                            <orig>m̅</orig>
                            <reg>mm</reg>
                        </choice>er </add><subst>
                        <del rendition="#ow"><del rendition="#s"><gap reason="illegible" quantity="1" unit="words"/></del></del>
                        <add place="across">zu</add>
                    </subst>
                    <subst>
                        <del rendition="#ow"><del rendition="#s"><gap reason="illegible" quantity="2" unit="chars"/></del></del>
                        <add place="across">fo</add>
                    </subst>lgen. Ich schickte mich an<supplied cert="high">,</supplied> nur noch
                    <lb/>das Nothwendigste <add place="sublinear"><subst>
                            <del rendition="#ow">aus</del>
                            <add place="across">von</add>
                        </subst> den hiesi<supplied cert="high">g</supplied>en Foßil<supplied cert="high">i</supplied>en </add>durch <choice>
                        <abbr>Hr</abbr>
                        <expan>Herrn</expan>
                    </choice>
                    <persName ref="https://edition-humboldt.de/H5648664 https://d-nb.info/gnd/118525786">Dinkel</persName> zeichnen zu laßen <choice>
                        <abbr>u</abbr>
                        <expan>und</expan>
                    </choice> mich <add place="superlinear">da<choice>
                            <orig>n̅</orig>
                            <reg>nn</reg>
                        </choice>
                    </add><subst>
                        <del rendition="#ow"><gap reason="covered" unit="words" quantity="1"/></del>
                        <add place="across">von</add>
                    </subst>
                    <lb/>diese<subst>
                        <del rendition="#ow">n</del>
                        <add place="across">m</add>
                    </subst> treuen Gefährten <subst>
                        <del rendition="#s">zu</del>
                        <add place="across">so</add>
                    </subst> bald als möglich zu tre<subst>
                        <del rendition="#ow"><gap reason="covered" unit="chars" quantity="2"/></del>
                        <add place="across"><choice>
                                <orig>n̅</orig>
                                <reg>nn</reg>
                            </choice></add>
                    </subst>en<subst>
                        <del rendition="#s">,</del>
                        <add place="intralinear">.</add>
                    </subst> Son̅tag<lb/>wollte ich Ihnen diesen Entschluß mittheilen. <del rendition="#s"><gap reason="illegible" quantity="1" unit="words"/></del>
                    <subst>
                        <del rendition="#ow"><gap/></del>
                        <add place="across">Und</add>
                    </subst>
                    <subst>
                        <del rendition="#ow"><gap reason="covered" unit="words" quantity="1"/></del>
                        <add place="across">nun</add>
                    </subst>
                    <add place="sublinear">erhalte ich</add> heute Ihre <lb/>Sendung. Stellen Sie
                    sich vor<supplied cert="high">,</supplied> welche Gefühle<choice>
                        <sic>,</sic>
                        <corr type="deleted"/>
                    </choice> den <hi rendition="#mMM"><lb/>durchdringen müßen, der entschloßen
                            ist<supplied cert="high">,</supplied> allem <del rendition="#s">dem</del> zu entsagen, was ihm</hi>
                    <lb/><hi rendition="#mMM"><add place="superlinear">bisher </add>im Leben als das
                        Höchste <choice>
                            <abbr>u</abbr>
                            <expan>und</expan>
                        </choice> Wünschenswertheste erschienen war,</hi><lb/><hi rendition="#mMM"><choice>
                            <abbr>u</abbr>
                            <expan>und</expan>
                        </choice> der nun unerwartet durch eine gütige hülfreiche Hand aus
                        dieser</hi>
                    <lb/>traurigen Lage gerissen, von neuem der schönen Hoffnung <subst>
                        <del rendition="#ow"><unclear reason="covered" cert="high">aus</unclear></del>
                        <add place="across">le</add>
                    </subst>ben <lb/><hi rendition="#mMM">darf<supplied cert="high">,</supplied>
                        seine <add place="superlinear">ganzen </add>Kräfte der Wissenschaft zu
                        weihen <choice>
                            <abbr>u</abbr>
                            <expan>und</expan>
                        </choice> Sie</hi><pb n="1v"/>kö<choice>
                        <orig>n̅</orig>
                        <reg>nn</reg>
                    </choice>en sich einen Begriff <add place="superlinear">von</add>
                    <subst>
                        <del rendition="#ow"><gap reason="covered" unit="words" quantity="2"/></del>
                        <add place="across">der Lage<del rendition="#s">n</del></add>
                    </subst> machen, in die mich Ihr <lb/>theurer Brief versetzt hat<subst>
                        <del rendition="#ow">–</del>
                        <add place="across">.</add>
                    </subst>
                    <add place="superlinear">Möge </add>Gott <subst>
                        <del rendition="#ow">habe <gap reason="covered" unit="words" quantity="1"/></del>
                        <add place="across">mein</add>
                    </subst>
                    <subst>
                        <del rendition="#ow"><gap reason="covered" unit="words" quantity="1"/></del>
                        <add place="across">Gebeth</add>
                    </subst>
                    <add place="across">für Sie </add><subst>
                        <del rendition="#ow"><gap reason="covered" unit="chars" quantity="4"/></del>
                        <add place="across">er</add>
                    </subst>höhren <lb/><choice>
                        <abbr>u</abbr>
                        <expan>und</expan>
                    </choice> Ihnen tausendfach vergelten, was ich Ihnen nur d<supplied cert="high">urc</supplied>h<lb/>Dankbarkeit
                    bezeugen ka<choice>
                        <orig>n̅</orig>
                        <reg>nn</reg>
                    </choice>, möge er mir die Ausdauer schenken<supplied cert="high">,</supplied>
                    <lb/>ohne welche<choice>
                        <sic>,</sic>
                        <corr type="deleted"/>
                    </choice> ich das Ziel <add place="continuedElsewhere"><hi rendition="#sup">1</hi>nicht erreichen <lb/>ka<choice>
                            <orig>n̅</orig>
                            <reg>nn</reg>
                        </choice></add><supplied cert="high">,</supplied>
                    <hi rendition="#sup">2</hi>welches mir <add place="sublinear">durch Ihr
                        Wohlwollen <choice>
                            <abbr>u</abbr>
                            <expan>und</expan>
                        </choice> Ihre Freygebigk<supplied cert="high">ei</supplied>t </add>wieder
                    vorleuchtet,
                        <del rendition="#s"><hi rendition="#sup">1</hi>nicht erreichen <lb/>ka<choice>
                            <orig>n̅</orig>
                            <reg>nn</reg>
                        </choice></del>.</p>
                <p>Ehrfurcht, Dank <subst>
                        <del rendition="#ow"><choice>
                                <abbr>u</abbr>
                                <expan>und</expan>
                            </choice></del>
                        <add place="across">,</add>
                    </subst> unbedingte<supplied cert="high">s</supplied>
                    <subst>
                        <del rendition="#ow">Ergebenh<supplied cert="high">ei</supplied>t</del>
                        <add place="across">Vertrauen</add>
                    </subst>
                    <choice>
                        <abbr>u</abbr>
                        <expan>und</expan>
                    </choice> Ergebenh<supplied cert="high">ei</supplied>t <lb/>sind die Gefühle <subst>
                        <del rendition="#ow">m</del>
                        <add place="across">w</add>
                    </subst>elche mich <subst>
                        <del rendition="#ow">für</del>
                        <add place="across"><subst>
                                <del rendition="#ow">gegen</del>
                                <add place="across">für</add>
                            </subst></add>
                    </subst> Sie erfüllen.</p>
                <closer>
                    <salute>Ganz der Ihrige</salute>
                    <signed><persName ref="https://edition-humboldt.de/H0012520 http://d-nb.info/gnd/118643967">L<hi rendition="#sup">s</hi>
                        Ag</persName>.</signed>
                    <dateline>den <date when="1832-03-27" calendar="#gregorian">27<hi rendition="#sup">t</hi> März 1832</date>.</dateline>
                </closer>
                
                <note place="mBottom" hand="#author"><del rendition="#s">6</del>
                    7<hi rendition="#sup">t</hi>. <unclear reason="illegible" cert="high">Junot</unclear>.</note>
                <note place="mBottom" hand="#author"><persName ref="https://edition-humboldt.de/H0012069 http://d-nb.info/gnd/118554700">Humboldt</persName>.</note>
                <note place="mBottom" hand="#unknown"><foreign xml:lang="fra"><subst>
                            <del rendition="#ow">Neuch</del>
                            <add place="across"><placeName ref="https://edition-humboldt.de/H0008129 https://www.geonames.org/2988507">Paris</placeName></add>
                        </subst> le <date when="1832-03-27" calendar="#gregorian">27 Mars
                            1832</date></foreign>
                    <lb/><add hand="https://edition-humboldt.de/unknown" place="superlinear"><foreign xml:lang="eng">to
                        </foreign></add><persName ref="https://edition-humboldt.de/H0012069 http://d-nb.info/gnd/118554700"><hi rendition="#u">Humboldt</hi></persName></note>
                <note place="mBottom" hand="#unknown">
                    <foreign xml:lang="eng">from <persName ref="https://edition-humboldt.de/H0012520 http://d-nb.info/gnd/118643967"><choice>
                                <abbr>Ls</abbr>
                                <expan>Louis</expan>
                            </choice> Agassiz</persName> answering to letter <lb/>offering
                        money</foreign><lb/></note>
            </div>
        </body></text>
