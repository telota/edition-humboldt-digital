                                <abbr>Soc</abbr>
                                <expan>Société</expan>
                            </choice>
                            <choice>
                                <abbr>géolog.</abbr>
                                <expan>géologique</expan>
                            </choice>
                            <lb/>2<hi rendition="#sup"><choice>
                                    <sic>me</sic>
                                    <corr cert="high">ième</corr>
                                </choice>
                            </hi> Série <choice>
