                            </choice>
                        </bibl><supplied cert="high">,</supplied> übersezt von <lb/><bibl ref="https://edition-humboldt.de/V9UUGWVR"><persName ref="https://edition-humboldt.de/H0000725 http://d-nb.info/gnd/116327480"><choice>
                                    <abbr>Rammelsb.</abbr>
                                    <expan>Rammelsberg</expan>
                                </choice>
                            </persName>
                            <choice>
                                <abbr>Deut</abbr>
                                <expan>Deutsche</expan>
                            </choice>
