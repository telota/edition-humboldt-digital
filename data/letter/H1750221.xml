    <text><body>
            <div type="writingSession">
                <p><pb n="1r"/>Es wird mir eine grosse Freude <lb/>sein, Sie, mein theurer <persName ref="https://edition-humboldt.de/H0012520 http://d-nb.info/gnd/118643967">Agassiz</persName><supplied cert="high">,</supplied>
                    <lb/><date when="1832-03-29" calendar="#gregorian">übermorgen<supplied cert="high">,</supplied> Donnerstags</date> früh<supplied cert="high">,</supplied>
                    <lb/>etwas vor neun Uhr<supplied cert="high">,</supplied> zu
                        <lb/>empfangen<supplied cert="high">.</supplied></p>
                <closer>
                    <dateline><date when="1832-03-27" calendar="#gregorian">Dienstags</date>
                    </dateline><space dim="horizontal"/>
                    <signed><persName ref="https://edition-humboldt.de/H0012069 http://d-nb.info/gnd/118554700">Ihr <lb type="preserve"/>Al
                        Humboldt</persName></signed>
                    <pb n="1v"/><address>
                        <addrLine>à Monsieur</addrLine>
                        <addrLine>Monsieur le Docteur</addrLine>
                        <addrLine><persName ref="https://edition-humboldt.de/H0012520 http://d-nb.info/gnd/118643967">Agassiz</persName></addrLine>
                        <addrLine>Rue
                            Copeau</addrLine>
                        <addrLine><choice>
                                <abbr>n</abbr>
                                <expan>numéro</expan>
                            </choice> 4</addrLine>
                        <addrLine>près le<del rendition="#s">s</del>
                            <orgName ref="https://edition-humboldt.de/H0000553 http://d-nb.info/gnd/16130288-9">Jardin <lb/>des Plantes</orgName></addrLine>
                        <note place="mTop" hand="#unknown"><placeName ref="https://edition-humboldt.de/H0008129 https://www.geonames.org/2988507">Paris</placeName> le
                                <date when="1832-03-28" calendar="#gregorian">28 Mars
                                    <lb/>183<sic>1</sic></date>
                            <lb/><persName ref="https://edition-humboldt.de/H0012069 http://d-nb.info/gnd/118554700">Humboldt</persName></note>
