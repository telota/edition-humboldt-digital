                                    <expan>pagina</expan>
                                </choice> 214</ref><note xml:id="ee538f2e-3ff6-49f8-938f-2e3ff689f8dd" corresp="#a52d43a2-48cd-42ff-ad43-a248cdb2ff2b" type="editorial">
                                <bibl ref="https://edition-humboldt.de/D37WFUS6">Kunth 1847</bibl>, I.</note>
