                        </row>
                        <row>
                            <cell>in <ref xml:id="c14e972e-99ce-4095-8e97-2e99ce109539" corresp="#b09ceb0d-4f5a-49db-9ceb-0d4f5ae9dbe6" type="editorialNote"><bibl ref="https://edition-humboldt.de/6ZR5F4D5"><persName ref="https://edition-humboldt.de/H0012873 http://d-nb.info/gnd/116442921"><choice>
