                                <bibl ref="https://edition-humboldt.de/WA9BRUNP">Endlicher/Unger
                                1843</bibl>.</note>
                        <lb/><ref xml:id="cdb966fe-9920-4702-b966-fe9920f702a4" corresp="#bc38d7f0-7b3c-4fcb-b8d7-f07b3c9fcbf8" type="editorialNote"><persName ref="https://edition-humboldt.de/H0012148 http://d-nb.info/gnd/118523813">Darwin</persName>
                                <lb/><choice>
